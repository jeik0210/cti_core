<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_cti_portal" model="res.groups.privilege">
        <field name="name">Portal de consultas</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_cti_manager" model="res.groups">
        <field name="name">Administrador del portal de consultas</field>
        <field name="privilege_id" ref="privilege_cti_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_cti_intelligence_category_portal" model="ir.rule">
        <field name="name">Los clientes solo pueden consultar categorías activas</field>
        <field name="model_id" ref="model_cti_intelligence_category"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_cti_intelligence_subcategory_portal" model="ir.rule">
        <field name="name">Los clientes solo pueden consultar subcategorías activas</field>
        <field name="model_id" ref="model_cti_intelligence_subcategory"/>
        <field name="domain_force">[('active', '=', True), ('category_id.active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
