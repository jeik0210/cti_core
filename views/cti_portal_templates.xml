<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_breadcrumbs_cti_services" name="Consultas portal breadcrumbs" inherit_id="portal.portal_breadcrumbs" priority="45">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'cti_intelligence'" class="breadcrumb-item active">Catálogo</li>
            <li t-if="page_name == 'cti_intelligence_subcategory'" class="breadcrumb-item">
                <a href="/my/consultas">Catálogo</a>
            </li>
            <li t-if="page_name == 'cti_intelligence_subcategory'" class="breadcrumb-item active" t-out="subcategory.name"/>
        </xpath>
    </template>

    <template id="portal_my_home_cti_services" name="Consultas OSINT" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Catálogo de inteligencia</t>
                <t t-set="text">Explora las categorías y subcategorías disponibles</t>
                <t t-set="url" t-value="'/my/consultas'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_landing" name="Portal de consultas">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure o_cti_landing">
                <section class="o_cti_hero">
                    <div class="container">
                        <div class="row align-items-center g-4 py-4 py-lg-5 o_cti_hero_inner">
                        <div class="col-lg-7">
                            <p class="o_cti_eyebrow">INTELIGENCIA ABIERTA · PERÚ</p>
                            <h1 class="o_cti_hero_title">Inteligencia organizada en un solo lugar.</h1>
                            <p class="o_cti_hero_description">Explora capacidades de inteligencia organizadas en cuatro categorías y sus áreas especializadas.</p>
                            <a t-if="is_public" class="o_cti_primary_link" href="/web/login?redirect=/my/consultas">Ingresar al portal <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                            <a t-else="" class="o_cti_primary_link" href="/my/consultas">Ir al catálogo <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                        </div>
                        <div class="col-lg-5">
                            <div class="o_cti_hero_panel">
                                <div class="o_cti_panel_header">
                                    <span>Índice de inteligencia</span>
                                    <span><i class="fa fa-database" aria-hidden="true"/> 4 categorías</span>
                                </div>
                                <div class="o_cti_panel_item">
                                    <span class="o_cti_panel_icon"><i class="fa fa-id-card" aria-hidden="true"/></span>
                                    <span><strong>Identidades</strong><small>Teléfonos, redes sociales y correos</small></span>
                                </div>
                                <div class="o_cti_panel_item">
                                    <span class="o_cti_panel_icon"><i class="fa fa-globe" aria-hidden="true"/></span>
                                    <span><strong>Infraestructura digital</strong><small>Dominios, archivos y exposición</small></span>
                                </div>
                                <div class="o_cti_panel_item">
                                    <span class="o_cti_panel_icon"><i class="fa fa-map-marker" aria-hidden="true"/></span>
                                    <span><strong>Empresas, finanzas y geoespacial</strong><small>Otras áreas especializadas</small></span>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <template id="portal_query_services" name="Catálogo de inteligencia">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'cti_intelligence'"/>
            <div class="container py-4 o_cti_member o_cti_catalog_page">
                <canvas class="o_cti_network_canvas" aria-hidden="true"/>
                <div class="o_cti_catalog_utility">
                    <div class="o_cti_catalog_system">
                        <span class="o_cti_status_light" aria-hidden="true"/>
                        <span>UNIDAD DE INVESTIGACIÓN</span>
                        <span class="o_cti_utility_divider">/</span>
                        <span>ÍNDICE DE CAPACIDADES</span>
                    </div>
                    <span class="o_cti_catalog_edition">CTI · CATÁLOGO 01</span>
                </div>

                <header class="o_cti_catalog_heading">
                    <div>
                        <p class="o_cti_eyebrow">MAPA DE INTELIGENCIA <span>—</span> ÁREAS ESPECIALIZADAS</p>
                        <h1>Catálogo de inteligencia</h1>
                        <p>Selecciona un dominio para explorar sus capacidades de investigación.</p>
                    </div>
                    <div class="o_cti_catalog_summary">
                        <span class="o_cti_summary_label">DOMINIOS ACTIVOS</span>
                        <strong t-out="len(catalog)"/>
                    </div>
                </header>

                <section class="o_cti_intelligence_catalog" aria-label="Categorías de inteligencia">
                    <t t-foreach="catalog" t-as="item">
                        <t t-set="category" t-value="item['category']"/>
                        <section t-attf-class="o_cti_intelligence_group o_cti_domain_#{category.sequence}">
                            <header class="o_cti_group_heading">
                                <span class="o_cti_group_index" t-out="'%02d' % (item_index + 1)"/>
                                <span class="o_cti_group_icon">
                                    <i t-attf-class="fa #{category.icon or 'fa-folder'}" aria-hidden="true"/>
                                </span>
                                <div class="o_cti_group_title">
                                    <span class="o_cti_group_code" t-out="category.code"/>
                                    <h2 t-out="category.name"/>
                                </div>
                            </header>
                            <div class="o_cti_subgroup_grid">
                                <t t-foreach="item['subcategories']" t-as="subcategory">
                                    <a class="o_cti_subgroup_card o_cti_subgroup_link"
                                       t-att-href="'/my/consultas/' + subcategory.code"
                                       t-attf-aria-label="Abrir #{subcategory.name}">
                                        <span class="o_cti_subgroup_content">
                                            <span class="o_cti_subgroup_code" t-out="subcategory.code"/>
                                            <h3 t-out="subcategory.name"/>
                                        </span>
                                        <i class="fa fa-external-link o_cti_subgroup_open" aria-hidden="true"/>
                                    </a>
                                </t>
                            </div>
                        </section>
                    </t>
                </section>
            </div>
        </t>
    </template>

    <template id="portal_intelligence_subcategory" name="Espacio de subcategoría">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'cti_intelligence_subcategory'"/>
            <main class="container py-4 o_cti_member o_cti_subcategory_page">
                <section class="o_cti_subcategory_workspace" aria-label="Área de trabajo">
                    <aside class="o_cti_workspace_sidebar" aria-label="Menú de consultas">
                        <button type="button" class="o_cti_workspace_group_toggle" data-cti-group-toggle="o_cti_analysis_menu" aria-controls="o_cti_analysis_menu" aria-expanded="true">
                            <span><i class="fa fa-cubes" aria-hidden="true"/> ANÁLISIS</span>
                            <i class="fa fa-minus-square-o o_cti_workspace_group_indicator" aria-hidden="true"/>
                        </button>
                        <nav id="o_cti_analysis_menu" class="o_cti_workspace_tools" aria-label="Análisis">
                            <button type="button" class="o_cti_workspace_menu_item active"
                                    data-cti-panel="phone" aria-controls="o_cti_panel_phone" aria-expanded="true">
                                <i class="fa fa-mobile" aria-hidden="true"/> Búsqueda por celular
                            </button>
                            <button type="button" class="o_cti_workspace_menu_item"
                                    data-cti-panel="identity" aria-controls="o_cti_panel_identity" aria-expanded="false">
                                <i class="fa fa-user-o" aria-hidden="true"/> Consulta de identidad
                            </button>
                            <button type="button" class="o_cti_workspace_menu_item"
                                    data-cti-panel="records" aria-controls="o_cti_panel_records" aria-expanded="false">
                                <i class="fa fa-folder-o" aria-hidden="true"/> Registros públicos
                            </button>
                        </nav>
                        <button type="button" class="o_cti_workspace_group_toggle" data-cti-group-toggle="o_cti_history_menu" aria-controls="o_cti_history_menu" aria-expanded="false">
                            <span><i class="fa fa-history" aria-hidden="true"/> HISTORIAL</span>
                            <i class="fa fa-plus-square-o o_cti_workspace_group_indicator" aria-hidden="true"/>
                        </button>
                        <nav id="o_cti_history_menu" class="o_cti_workspace_tools" aria-label="Historial" hidden="hidden">
                            <button type="button" class="o_cti_workspace_menu_item" data-cti-panel="history" aria-controls="o_cti_panel_history" aria-expanded="false">
                                <i class="fa fa-list-alt" aria-hidden="true"/> Consultas recientes
                            </button>
                        </nav>
                        <button type="button" class="o_cti_workspace_group_toggle" data-cti-group-toggle="o_cti_guides_menu" aria-controls="o_cti_guides_menu" aria-expanded="false">
                            <span><i class="fa fa-book" aria-hidden="true"/> GUÍAS</span>
                            <i class="fa fa-plus-square-o o_cti_workspace_group_indicator" aria-hidden="true"/>
                        </button>
                        <nav id="o_cti_guides_menu" class="o_cti_workspace_tools" aria-label="Guías" hidden="hidden">
                            <button type="button" class="o_cti_workspace_menu_item" data-cti-panel="guides" aria-controls="o_cti_panel_guides" aria-expanded="false">
                                <i class="fa fa-info-circle" aria-hidden="true"/> Guía de uso
                            </button>
                        </nav>
                        <button type="button" class="o_cti_workspace_group_toggle" data-cti-group-toggle="o_cti_statistics_menu" aria-controls="o_cti_statistics_menu" aria-expanded="false">
                            <span><i class="fa fa-bar-chart" aria-hidden="true"/> ESTADÍSTICA</span>
                            <i class="fa fa-plus-square-o o_cti_workspace_group_indicator" aria-hidden="true"/>
                        </button>
                        <nav id="o_cti_statistics_menu" class="o_cti_workspace_tools" aria-label="Estadística" hidden="hidden">
                            <button type="button" class="o_cti_workspace_menu_item" data-cti-panel="statistics" aria-controls="o_cti_panel_statistics" aria-expanded="false">
                                <i class="fa fa-pie-chart" aria-hidden="true"/> Resumen de actividad
                            </button>
                        </nav>
                    </aside>
                    <div class="o_cti_workspace_content">
                        <section id="o_cti_panel_phone" class="o_cti_workspace_panel" data-cti-content="phone">
                            <p class="o_cti_eyebrow">HERRAMIENTA DE CONSULTA</p>
                            <h2>Búsqueda por celular</h2>
                            <p class="o_cti_workspace_description">Ingresa el número que deseas consultar.</p>
                            <form class="o_cti_phone_form" action="#" method="get">
                                <label for="cti_phone_number">Número de celular</label>
                                <div class="o_cti_phone_input_row">
                                    <input id="cti_phone_number" name="phone" type="tel" inputmode="tel"
                                           autocomplete="tel" placeholder="Ej. 987 654 321" required="required"/>
                                    <button class="btn btn-primary" type="submit">Consultar</button>
                                </div>
                            </form>
                        </section>
                        <section id="o_cti_panel_identity" class="o_cti_workspace_panel" data-cti-content="identity" hidden="hidden">
                            <p class="o_cti_eyebrow">PRÓXIMAMENTE</p>
                            <h2>Consulta de identidad</h2>
                            <p class="o_cti_workspace_description">Esta herramienta estará disponible próximamente.</p>
                        </section>
                        <section id="o_cti_panel_records" class="o_cti_workspace_panel" data-cti-content="records" hidden="hidden">
                            <p class="o_cti_eyebrow">PRÓXIMAMENTE</p>
                            <h2>Registros públicos</h2>
                            <p class="o_cti_workspace_description">Esta herramienta estará disponible próximamente.</p>
                        </section>
                        <section id="o_cti_panel_history" class="o_cti_workspace_panel" data-cti-content="history" hidden="hidden">
                            <p class="o_cti_eyebrow">HISTORIAL</p>
                            <h2>Consultas recientes</h2>
                            <p class="o_cti_workspace_description">Aquí se mostrarán las consultas realizadas.</p>
                        </section>
                        <section id="o_cti_panel_guides" class="o_cti_workspace_panel" data-cti-content="guides" hidden="hidden">
                            <p class="o_cti_eyebrow">GUÍAS</p>
                            <h2>Guía de uso</h2>
                            <p class="o_cti_workspace_description">Aquí encontrarás instrucciones para usar las herramientas.</p>
                        </section>
                        <section id="o_cti_panel_statistics" class="o_cti_workspace_panel" data-cti-content="statistics" hidden="hidden">
                            <p class="o_cti_eyebrow">ESTADÍSTICA</p>
                            <h2>Resumen de actividad</h2>
                            <p class="o_cti_workspace_description">Aquí se mostrarán estadísticas de actividad.</p>
                        </section>
                    </div>
                </section>
            </main>
        </t>
    </template>
</odoo>
