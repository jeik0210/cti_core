<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cti_entity_list" model="ir.ui.view">
        <field name="name">cti.entity.list</field>
        <field name="model">cti.entity</field>
        <field name="arch" type="xml">
            <list string="Entidades e IoC" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'">
                <field name="name"/>
                <field name="entity_type"/>
                <field name="value"/>
                <field name="state"/>
                <field name="severity"/>
                <field name="confidence"/>
                <field name="source_ids" widget="many2many_tags"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="view_cti_entity_form" model="ir.ui.view">
        <field name="name">cti.entity.form</field>
        <field name="model">cti.entity</field>
        <field name="arch" type="xml">
            <form string="Entidad / IoC">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,investigating,confirmed,false_positive,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Servidor sospechoso"/></h1>
                    </div>
                    <group>
                        <group string="Indicador">
                            <field name="entity_type"/>
                            <field name="value"/>
                            <field name="severity"/>
                            <field name="confidence"/>
                        </group>
                        <group string="Detección">
                            <field name="source_ids" widget="many2many_tags"/>
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Contexto">
                        <field name="description" placeholder="Contexto, análisis y notas..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cti_entity_search" model="ir.ui.view">
        <field name="name">cti.entity.search</field>
        <field name="model">cti.entity</field>
        <field name="arch" type="xml">
            <search string="Buscar entidades e IoC">
                <field name="name"/>
                <field name="value"/>
                <field name="entity_type"/>
                <field name="source_ids"/>
                <filter name="active_only" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="high_severity" string="Alta severidad" domain="[('severity', 'in', ['high', 'critical'])]"/>
                <filter name="investigating" string="En investigación" domain="[('state', '=', 'investigating')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_type" string="Tipo" context="{'group_by': 'entity_type'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_severity" string="Severidad" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cti_entity" model="ir.actions.act_window">
        <field name="name">Entidades e IoC</field>
        <field name="res_model">cti.entity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cti_entity_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>
</odoo>
